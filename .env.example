# ==============================================================================
# Mail-E: Campus Placement Notification Engine
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000

# MongoDB Database Connection String
# Local fallback: mongodb://127.0.0.1:27017/mail_e
# Cloud MongoDB Atlas:
MONGODB_URI=mongodb://127.0.0.1:27017/mail_e

# Google Gemini API Key (for LLM placement intelligence extraction)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (for Gmail API message ingestion)
# Obtain from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# Telegram Bot Credentials (for real-time placement alerts)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Android SMS Gateway (Direct Connection over Local Wi-Fi)
# Enter your Android phone's local IP address and port (default: 8080)
SMS_GATEWAY_URL=http://192.168.1.45:8080
SMS_GATEWAY_USERNAME=sms
SMS_GATEWAY_PASSWORD=123456789
STUDENT_PHONE=+919876543210

# Dual-SIM Routing (1 for SIM 1, 2 for SIM 2)
SMS_GATEWAY_SIM_NUMBER=2
